---
// Standalone landing page for testform in English
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>testform - Declarative Test as Code Platform</title>
  <meta name="description" content="Declarative test orchestration engine: zero mandatory SaaS servers and zero Test Drift. Manage your entire QA lifecycle directly in Git." />
  
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

  <!-- Inline Theme Initialization to Prevent Flash of Wrong Theme -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('starlight-theme') || localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.dataset.theme = 'light';
      } else if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.dataset.theme = 'dark';
      } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.classList.remove('dark');
        document.documentElement.dataset.theme = 'light';
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.dataset.theme = 'dark';
      }
    })();
  </script>

  <style>
    @layer base {
      html, body {
        margin: 0;
        padding: 0;
      }
      body {
        overscroll-behavior: none;
      }
    }
    ::-webkit-scrollbar {
      display: none;
    }
  </style>

  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface": "#0f131c",
            "surface-dim": "#0f131c",
            "surface-bright": "#353943",
            "surface-container-lowest": "#0a0e17",
            "surface-container-low": "#181b25",
            "surface-container": "#1c1f29",
            "surface-container-high": "#262a34",
            "surface-container-highest": "#31353f",
            "on-surface": "#dfe2ef",
            "on-surface-variant": "#bbcabf",
            "inverse-surface": "#dfe2ef",
            "inverse-on-surface": "#2c303a",
            "outline": "#86948a",
            "outline-variant": "#3c4a42",
            // Primary Brand Blue (#2563eb in light / #3b82f6 in dark)
            "primary": "#3b82f6",
            "primary-container": "#2563eb",
            "on-primary": "#ffffff",
            "on-primary-container": "#eff6ff",
            "primary-fixed": "#60a5fa",
            "primary-fixed-dim": "#3b82f6",
            // Secondary Cyan (#0284c7)
            "secondary": "#38bdf8",
            "secondary-container": "#0284c7",
            "on-secondary": "#003640",
            "secondary-fixed": "#bae6fd",
            "secondary-fixed-dim": "#38bdf8",
            // Tertiary Indigo/Violet
            "tertiary": "#c084fc",
            "tertiary-container": "#9333ea",
            "on-tertiary": "#3c0091",
            "error": "#ffb4ab",
            "error-container": "#93000a",
            "on-error": "#690005"
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            sm: "0.125rem",
            md: "0.375rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px"
          },
          spacing: {
            margin: "1rem",
            "margin-tablet": "2rem",
            "margin-desktop": "3rem",
            gutter: "1.25rem",
            "gutter-desktop": "1.5rem",
            "space-xs": "0.25rem",
            "space-sm": "0.5rem",
            "space-md": "1rem",
            "space-lg": "1.5rem",
            "space-xl": "2.5rem"
          },
          fontFamily: {
            "display-lg": ["Geist", "sans-serif"],
            "headline-lg": ["Geist", "sans-serif"],
            "headline-md": ["Geist", "sans-serif"],
            "headline-sm": ["Geist", "sans-serif"],
            "body-lg": ["Geist", "sans-serif"],
            "body-md": ["Geist", "sans-serif"],
            "body-sm": ["Geist", "sans-serif"],
            "code-lg": ["JetBrains Mono", "monospace"],
            "code-md": ["JetBrains Mono", "monospace"],
            "code-sm": ["JetBrains Mono", "monospace"],
            "label-md": ["JetBrains Mono", "monospace"],
            "label-sm": ["JetBrains Mono", "monospace"]
          },
          fontSize: {
            "display-lg": ["56px", { lineHeight: "64px", letterSpacing: "-0.03em", fontWeight: "700" }],
            "display-lg-mobile": ["36px", { lineHeight: "44px", letterSpacing: "-0.02em", fontWeight: "700" }],
            "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.02em", fontWeight: "600" }],
            "headline-lg-mobile": ["26px", { lineHeight: "34px", letterSpacing: "-0.01em", fontWeight: "600" }],
            "headline-md": ["24px", { lineHeight: "32px", letterSpacing: "-0.015em", fontWeight: "600" }],
            "headline-sm": ["18px", { lineHeight: "26px", letterSpacing: "-0.01em", fontWeight: "600" }],
            "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
            "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
            "body-sm": ["12px", { lineHeight: "18px", fontWeight: "400" }],
            "code-lg": ["14px", { lineHeight: "22px", fontWeight: "500" }],
            "code-md": ["13px", { lineHeight: "20px", fontWeight: "400" }],
            "code-sm": ["11px", { lineHeight: "16px", fontWeight: "400" }],
            "label-md": ["12px", { lineHeight: "16px", letterSpacing: "0.04em", fontWeight: "500" }],
            "label-sm": ["10px", { lineHeight: "14px", letterSpacing: "0.06em", fontWeight: "600" }]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-white dark:bg-surface font-body-md text-body-md text-slate-800 dark:text-on-surface antialiased selection:bg-blue-500/20 selection:text-blue-600 dark:selection:text-blue-400 transition-colors duration-200">

  <!-- ========================================== -->
  <!-- HEADER NAVIGATION                          -->
  <!-- ========================================== -->
  <header class="fixed top-0 w-full z-50 bg-white/85 dark:bg-surface/85 backdrop-blur-xl border-b border-slate-200 dark:border-slate-800 transition-colors duration-200">
    <div class="h-16 w-full px-margin md:px-margin-tablet lg:px-margin-desktop max-w-7xl mx-auto flex items-center justify-between gap-space-md">
      
      <!-- Brand Name (zero gap between testform and dot) -->
      <div class="flex items-center gap-space-md">
        <a class="flex items-center gap-2 text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors" href={`${base}/en/`}>
          <span class="font-headline-sm text-headline-sm tracking-tight font-bold">testform<span class="text-blue-600 dark:text-blue-400 font-extrabold">.</span></span>
          <span class="font-label-sm text-label-sm px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950/60 dark:text-blue-400 dark:border-blue-800/80 tracking-widest uppercase">TaC</span>
        </a>
      </div>

      <!-- Clean Text Navigation Links (NOT buttons) -->
      <nav class="hidden md:flex items-center gap-8 font-label-md text-label-md">
        <a class="text-slate-600 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400 font-medium transition-colors" href={`${base}/en/docs/`}>Docs</a>
        <a class="text-slate-600 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400 font-medium transition-colors" href={`${base}/en/cli/`}>CLI</a>
        <a class="text-slate-600 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400 font-medium transition-colors" href={`${base}/en/api/`}>API</a>
      </nav>

      <!-- Right Header Actions: Pure Icons (GitHub, Theme Mode, Language) -->
      <div class="flex items-center gap-2">
        <!-- GitHub Icon Link -->
        <a
          class="flex items-center justify-center w-9 h-9 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-colors"
          href="https://github.com/fromeroc9/testform"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Repository"
          title="GitHub (v1.1.0)"
        >
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
        </a>

        <!-- Light / Dark Mode Toggle Icon Button -->
        <button
          id="theme-toggle-btn"
          onclick="toggleTheme()"
          class="flex items-center justify-center w-9 h-9 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-colors"
          type="button"
          aria-label="Toggle theme"
          title="Toggle light/dark mode"
        >
          <span class="dark:hidden text-slate-700">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </span>
          <span class="hidden dark:inline text-amber-300">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </span>
        </button>

        <!-- Language Toggle Icon Button (Icon only) -->
        <a
          href={`${base}/es/`}
          class="flex items-center justify-center w-9 h-9 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-colors"
          aria-label="Switch to Spanish"
          title="Switch to Spanish"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </a>

        <!-- VS Code Extension Link -->
        <a
          href="https://github.com/fromeroc9/testform-vscode/blob/master/testform-1.0.0.vsix"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-2.5 h-9 rounded-md text-slate-700 hover:text-blue-600 bg-slate-100 hover:bg-blue-50 dark:text-slate-200 dark:hover:text-blue-400 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 transition-colors font-medium text-xs shadow-xs"
          aria-label="Download VS Code extension (.vsix)"
          title="Download Testform VS Code Extension (.vsix)"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="text-blue-600 dark:text-blue-400">
            <path d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/>
          </svg>
          <span class="hidden sm:inline font-mono">VS Code</span>
        </a>

        <!-- Mobile Menu Toggle Button (Visible only on mobile) -->
        <button
          id="mobile-nav-toggle"
          type="button"
          class="md:hidden flex items-center justify-center w-9 h-9 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-colors"
          aria-label="Toggle navigation menu"
          title="Menu"
          onclick="toggleMobileMenu()"
        >
          <svg id="mobile-menu-icon-open" class="block" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg id="mobile-menu-icon-close" class="hidden" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer / Tabs (Docs, CLI, API) -->
    <div
      id="mobile-nav-drawer"
      class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-[#0f131c]/95 backdrop-blur-xl px-4 py-3 shadow-lg"
    >
      <div class="flex items-center justify-around gap-2 p-1 bg-slate-100 dark:bg-surface-container-high rounded-lg">
        <a
          href={`${base}/en/docs/`}
          class="flex-1 py-2 px-3 text-center rounded-md font-semibold text-sm text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-white dark:hover:bg-surface-container transition-all"
        >
          Docs
        </a>
        <a
          href={`${base}/en/cli/`}
          class="flex-1 py-2 px-3 text-center rounded-md font-semibold text-sm text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-white dark:hover:bg-surface-container transition-all"
        >
          CLI
        </a>
        <a
          href={`${base}/en/api/`}
          class="flex-1 py-2 px-3 text-center rounded-md font-semibold text-sm text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-white dark:hover:bg-surface-container transition-all"
        >
          API
        </a>
      </div>
    </div>
  </header>

  <!-- ========================================== -->
  <!-- MAIN CONTENT                               -->
  <!-- ========================================== -->
  <main class="w-full pt-16 min-h-screen">
    <div class="flex flex-col w-full">

      <!-- ========================================== -->
      <!-- 1. HERO SECTION                            -->
      <!-- ========================================== -->
      <section class="relative w-full py-space-xl overflow-hidden">
        <!-- Ambient Glow with Primary Blue -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-5xl h-96 bg-gradient-to-b from-blue-500/10 via-cyan-500/5 to-transparent blur-3xl pointer-events-none -z-10"></div>
        
        <div class="w-full px-margin md:px-margin-tablet lg:px-margin-desktop max-w-7xl mx-auto flex flex-col items-center text-center">
          
          <!-- Main Title H1 -->
          <h1 class="font-display-lg text-display-lg md:text-[56px] text-display-lg-mobile tracking-tight text-slate-900 dark:text-white mb-space-xs mt-space-sm">
            testform<span class="text-blue-600 dark:text-blue-400 inline-block font-extrabold">.</span>
          </h1>
          
          <!-- Highlighted Subtitle in Primary Blue -->
          <p class="font-headline-md text-headline-md text-blue-600 dark:text-blue-400 tracking-normal mb-space-md font-semibold">
            Declare, plan, apply, and reconcile in Git.
          </p>
          
          <!-- Description -->
          <p class="font-body-lg text-body-lg text-slate-600 dark:text-slate-300 max-w-3xl mb-space-xl">
            Declarative test framework: zero mandatory SaaS servers and zero Test Drift. Manage your entire QA lifecycle, version every test suite as source code, and ensure immutable cryptographic traceability in every commit.
          </p>

          <!-- Official Global Installation Command Box -->
          <div class="w-full max-w-xl bg-slate-50 dark:bg-surface-container-lowest rounded-xl p-space-sm shadow-xl border border-slate-200 dark:border-slate-800 flex flex-col gap-space-xs text-left">
            <!-- Box Header -->
            <div class="flex items-center justify-between px-space-sm pb-space-xs">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-50 dark:bg-blue-950/70 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800/80 font-mono text-[11px] font-bold tracking-wider uppercase">
                  <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                  npm
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">Global Installation</span>
              </div>
              <span class="font-label-sm text-label-sm text-slate-500 dark:text-slate-400 tracking-wider uppercase font-mono">v1.1.0 • verified</span>
            </div>
            
            <!-- Terminal Command Box -->
            <div class="flex items-center justify-between gap-space-md bg-slate-900 text-slate-100 dark:bg-surface-container-low dark:text-on-surface px-space-md py-space-sm rounded-lg border border-slate-800">
              <div class="flex items-center gap-space-sm min-w-0 font-code-md text-code-md">
                <span class="text-blue-400 select-none font-bold">&gt;</span>
                <span class="truncate font-code-md" id="cli-command-text">npm i -g @fromeroc9/testform@beta</span>
              </div>
              <button class="flex-shrink-0 flex items-center gap-space-xs px-space-sm py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-100 font-label-sm text-label-sm transition-all active:scale-95 cursor-pointer" id="copy-cli-btn" onclick="copyCliCommand()" type="button">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copy-btn-label">Copy</span>
              </button>
            </div>
          </div>

          <!-- Quick Metrics Counter Strip -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-space-md w-full max-w-4xl mt-space-xl pt-space-lg text-left">
            <div class="bg-slate-50 dark:bg-surface-container p-space-md rounded-lg shadow-sm border border-slate-200 dark:border-slate-800">
              <div class="font-label-sm text-label-sm text-slate-500 dark:text-slate-400 uppercase">Test Drift</div>
              <div class="font-headline-md text-headline-md text-blue-600 dark:text-blue-400 font-bold">0.0% Drift</div>
              <div class="font-body-sm text-body-sm text-slate-600 dark:text-slate-400">Synced via Git SHA</div>
            </div>
            <div class="bg-slate-50 dark:bg-surface-container p-space-md rounded-lg shadow-sm border border-slate-200 dark:border-slate-800">
              <div class="font-label-sm text-label-sm text-slate-500 dark:text-slate-400 uppercase">Per-Seat Cost</div>
              <div class="font-headline-md text-headline-md text-cyan-600 dark:text-cyan-400 font-bold">$0 / Dev</div>
              <div class="font-body-sm text-body-sm text-slate-600 dark:text-slate-400">100% free local & CI runs</div>
            </div>
            <div class="bg-slate-50 dark:bg-surface-container p-space-md rounded-lg shadow-sm border border-slate-200 dark:border-slate-800">
              <div class="font-label-sm text-label-sm text-slate-500 dark:text-slate-400 uppercase">Immutable Ledger</div>
              <div class="font-headline-md text-headline-md text-indigo-600 dark:text-indigo-400 font-bold">SHA-256</div>
              <div class="font-body-sm text-body-sm text-slate-600 dark:text-slate-400">Tests sealed in Git commit</div>
            </div>
            <div class="bg-slate-50 dark:bg-surface-container p-space-md rounded-lg shadow-sm border border-slate-200 dark:border-slate-800">
              <div class="font-label-sm text-label-sm text-slate-500 dark:text-slate-400 uppercase">Setup Time</div>
              <div class="font-headline-md text-headline-md text-slate-800 dark:text-white font-bold">&lt; 30 sec</div>
              <div class="font-body-sm text-body-sm text-slate-600 dark:text-slate-400">Native CLI, zero server</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- 2. INTEGRATED WORKBENCH: DECLARATIVE LIFECYCLE -->
      <!-- ========================================== -->
      <section class="w-full py-space-xl bg-slate-50 dark:bg-surface-container-lowest border-y border-slate-200 dark:border-slate-800 transition-colors duration-200">
