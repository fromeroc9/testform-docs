            <li><a class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" href="https://github.com/fromeroc9/testform/issues" target="_blank" rel="noopener noreferrer">Report an Issue</a></li>
            <li><a class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" href="https://www.npmjs.com/package/@fromeroc9/testform@beta" target="_blank" rel="noopener noreferrer">NPM Package</a></li>
          </ul>
        </div>

      </div>

      <div class="pt-space-md border-t border-slate-200 dark:border-slate-800 flex flex-col md:flex-row items-center justify-between gap-space-sm font-label-sm text-label-sm text-slate-500 dark:text-slate-400 font-mono">
        <div>
          <span>© 2026 testform. Distributed under Apache 2.0 License.</span>
        </div>
        <div class="flex items-center gap-space-md">
          <span class="text-blue-600 dark:text-blue-400">hash: 0x9e7a...tm</span>
          <span class="text-cyan-600 dark:text-cyan-400">cluster: ready</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- ========================================== -->
  <!-- CLIENT INTERACTION SCRIPTS                 -->
  <!-- ========================================== -->
  <script is:inline>
    // 1. THEME SWITCHER (DARK / LIGHT SYNCHRONIZED WITH STARLIGHT)
    function toggleTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';

      if (nextTheme === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.dataset.theme = 'dark';
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.dataset.theme = 'light';
      }

      localStorage.setItem('starlight-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
    }

    // 1.1 MOBILE NAVIGATION MENU TOGGLE
    function toggleMobileMenu() {
      const drawer = document.getElementById('mobile-nav-drawer');
      const openIcon = document.getElementById('mobile-menu-icon-open');
      const closeIcon = document.getElementById('mobile-menu-icon-close');
      if (!drawer) return;
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        if (openIcon) openIcon.classList.replace('block', 'hidden');
        if (closeIcon) closeIcon.classList.replace('hidden', 'block');
      } else {
        drawer.classList.add('hidden');
        if (openIcon) openIcon.classList.replace('hidden', 'block');
        if (closeIcon) closeIcon.classList.replace('block', 'hidden');
      }
    }

    document.addEventListener('click', (e) => {
      const drawer = document.getElementById('mobile-nav-drawer');
      const btn = document.getElementById('mobile-nav-toggle');
      if (drawer && btn && !drawer.classList.contains('hidden')) {
        if (!drawer.contains(e.target) && !btn.contains(e.target)) {
          drawer.classList.add('hidden');
          const openIcon = document.getElementById('mobile-menu-icon-open');
          const closeIcon = document.getElementById('mobile-menu-icon-close');
          if (openIcon) openIcon.classList.replace('hidden', 'block');
          if (closeIcon) closeIcon.classList.replace('block', 'hidden');
        }
      }
    });

    // 2. CLI COMMAND COPY
    function copyCliCommand() {
      const text = 'npm i -g @fromeroc9/testform@beta';
      navigator.clipboard.writeText(text).then(() => {
        const label = document.getElementById('copy-btn-label');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Copy'; }, 2000);
        }
      });
    }

    function copyFinalCommand() {
      navigator.clipboard.writeText('npm i -g @fromeroc9/testform@beta').then(() => {
        const label = document.getElementById('final-btn-label');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Copy Command'; }, 2000);
        }
      });
    }

    // 3. UNIFIED WORKBENCH SPEC TABS
    function selectEditorTab(tabKey) {
      const tabs = ['testcase', 'testrun', 'testplan'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const content = document.getElementById(`editor-content-${t}`);
        if (t === tabKey) {
          if (btn) btn.className = 'px-space-sm py-1.5 rounded-t text-left font-code-sm text-code-sm transition-colors bg-[#0f131c] text-blue-400 font-semibold flex items-center gap-1.5 border-t-2 border-blue-500';
          if (content) content.classList.remove('hidden');
        } else {
          if (btn) btn.className = 'px-space-sm py-1.5 rounded-t text-left font-code-sm text-code-sm transition-colors text-slate-400 hover:text-slate-200 hover:bg-[#1c2230] flex items-center gap-1.5 border-t-2 border-transparent';
          if (content) content.classList.add('hidden');
        }
      });
    }

    function manualEditorSelect(tabKey) {
      selectEditorTab(tabKey);
    }

    // 4. REALTIME LIFECYCLE CONSOLE PHASES (REAL TESTFORM LOGS)
    const lifecycleOutputs = {
      init: [
        '<span class="text-blue-400">$ testform init</span>',
        '<span class="text-slate-400">Initializing the backend "local"... [OK]</span>',
        '<span class="text-slate-400">Initializing provider plugins...</span>',
        '<span class="text-slate-200">- Finding provider "github"...</span>',
        '<span class="text-slate-200">- Installed provider "github" (v1.0)</span>',
        '<span class="text-blue-400 font-bold">✔ testform has been successfully initialized!</span>',
        '<span class="text-slate-400">You may now begin working with testform. Try running "testform plan".</span>'
      ],
      plan: [
        '<span class="text-blue-400">$ testform plan</span>',
        '<span class="text-slate-400">testform used selected providers to generate the execution plan:</span>',
        '<span class="text-blue-400 font-bold">  # github.testcase.todo.case.feature.@tc-001 will be created</span>',
        '<span class="text-cyan-300">  + resource "github_testcase" "todo.case.feature.@tc-001" {</span>',
        '<span class="text-cyan-300">      + uri     = "features/todo.case.feature"</span>',
        '<span class="text-cyan-300">      + labels  = ["@testcase", "@tc-001"]</span>',
        '<span class="text-cyan-300">      + title   = "Create a new task in TodoMVC"</span>',
        '<span class="text-cyan-300">    }</span>',
        '<span class="text-slate-200 font-semibold">Plan: <span class="text-blue-400 font-bold">1 to add</span>, <span class="text-cyan-400">0 to change</span>, <span class="text-slate-400">0 to destroy</span>.</span>',
        '<span class="text-blue-400 font-semibold">✔ State: Read-only check verified against testform.state</span>'
      ],
      apply: [
        '<span class="text-blue-400">$ testform apply -auto-approve</span>',
        '<span class="text-slate-400">Acquiring state lock on local:testform.state... [OK]</span>',
        '<span class="text-cyan-300">github.testcase.todo.case.feature.@tc-001: Creating...</span>',
        '<span class="text-emerald-400">github.testcase.todo.case.feature.@tc-001: Creation complete after 0.6s [id=PVTI_lADO #14]</span>',
        '<span class="text-slate-500">--------------------------------------------------</span>',
        '<span class="text-blue-400 font-bold">Apply complete! Resources: 1 added, 0 changed, 0 destroyed.</span>',
        '<span class="text-slate-400">State lock released. Zero drift maintained.</span>'
      ],
      diff: [
        '<span class="text-blue-400">$ testform diff --remote</span>',
        '<span class="text-slate-200 font-semibold"># testform Remote Drift Detection</span>',
        '<span class="text-slate-400">Checking local configuration and state against live remote provider...</span>',
        '<span class="text-slate-500">────────────────────────────────────────────────────────────</span>',
        '<span class="text-blue-400 font-bold">✔ No remote drift detected. Local configuration matches remote.</span>',
        '<span class="text-indigo-300">Remote Sync:   <span class="text-slate-200">GitHub Projects V2 (Project #4)</span></span>',
        '<span class="text-indigo-300">State Hash:    <span class="text-blue-400 font-mono font-bold">sha256:7c9e12... [VERIFIED]</span></span>',
        '<span class="text-blue-400 font-bold">✔ 0 drift detected. Remote project matches Git source of truth.</span>'
      ]
    };

    const phaseConfig = {
      init: { fileTab: 'testcase', label: 'PHASE 1 / 4', hash: 'SHA: 0x8a4b...INIT' },
      plan: { fileTab: 'testcase', label: 'PHASE 2 / 4', hash: 'SHA: 0x3d12...PLAN' },
      apply: { fileTab: 'testrun', label: 'PHASE 3 / 4', hash: 'SHA: 0x4f8e...APPLY' },
      diff: { fileTab: 'testplan', label: 'PHASE 4 / 4', hash: 'SHA: 0x7c9e...SYNCED' }
    };

    const phaseSequence = ['init', 'plan', 'apply', 'diff'];
    let currentPhaseIndex = 0;
    let autoLoopInterval = null;

    function applyPhaseState(phaseKey) {
      // 1. Update Buttons
      phaseSequence.forEach(p => {
        const btn = document.getElementById(`btn-phase-${p}`);
        if (btn) {
          if (p === phaseKey) {
            btn.className = 'px-space-sm py-1 rounded font-label-md text-label-md transition-all bg-blue-600 text-white font-bold shadow-sm';
          } else {
            btn.className = 'px-space-sm py-1 rounded font-label-md text-label-md transition-all bg-[#242b3d] hover:bg-[#2d364d] text-slate-300';
          }
        }
      });

      // 2. Terminal dynamic output
      const logContainer = document.getElementById('console-dynamic-log');
      const lines = lifecycleOutputs[phaseKey] || [];
      if (logContainer) {
        logContainer.innerHTML = lines.map(line => `<div>${line}</div>`).join('');
      }

      // 3. Corresponding spec editor tab
      const cfg = phaseConfig[phaseKey];
      if (cfg) {
        selectEditorTab(cfg.fileTab);
        const tag = document.getElementById('phase-countdown-tag');
        if (tag) tag.textContent = cfg.label;

        const hashDisplay = document.getElementById('console-hash-text');
        if (hashDisplay) {
          hashDisplay.textContent = cfg.hash;
          if (phaseKey === 'diff') {
            hashDisplay.className = 'text-blue-400 font-code-sm font-bold';
          } else if (phaseKey === 'apply') {
            hashDisplay.className = 'text-emerald-400 font-code-sm';
          } else {
            hashDisplay.className = 'text-blue-400 font-code-sm';
          }
        }
      }
    }

    function startAutoLoop() {
      if (autoLoopInterval) clearInterval(autoLoopInterval);
      autoLoopInterval = setInterval(() => {
        currentPhaseIndex = (currentPhaseIndex + 1) % phaseSequence.length;
        applyPhaseState(phaseSequence[currentPhaseIndex]);
      }, 4000);
    }

    function manualPhaseSelect(phaseKey) {
      currentPhaseIndex = phaseSequence.indexOf(phaseKey);
      applyPhaseState(phaseKey);
      startAutoLoop();
    }

    function restartLifecycleLoop() {
      manualPhaseSelect('init');
    }

    // 5. ROI DYNAMIC CALCULATOR
    function recalculateRoi() {
      const devSlider = document.getElementById('dev-count-slider');
      const costSlider = document.getElementById('seat-cost-slider');
      if (!devSlider || !costSlider) return;

      const devs = parseInt(devSlider.value, 10);
      const seatCost = parseInt(costSlider.value, 10);

      const devLabel = document.getElementById('dev-count-label');
      const costLabel = document.getElementById('seat-cost-label');
      if (devLabel) devLabel.textContent = `${devs} Engineers`;
      if (costLabel) costLabel.textContent = `${seatCost} USD / mo`;

      // Annual license savings = devs * seatCost * 12 months
      const annualSavings = devs * seatCost * 12;
      const savingsDisplay = document.getElementById('annual-savings-display');
      if (savingsDisplay) savingsDisplay.textContent = `$${annualSavings.toLocaleString('en-US')}`;

      // Estimated manual hours saved = devs * 1.5 hrs/week * 52 weeks
      const hoursSaved = Math.round(devs * 1.5 * 52);
      const hoursDisplay = document.getElementById('hours-saved-display');
      if (hoursDisplay) hoursDisplay.textContent = `${hoursSaved.toLocaleString('en-US')} hrs / yr`;
    }

    // Initializer on Load
    document.addEventListener('DOMContentLoaded', () => {
      applyPhaseState('init');
      startAutoLoop();
      recalculateRoi();
    });
  </script>

</body>
</html>
