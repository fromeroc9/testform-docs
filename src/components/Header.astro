---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const { locale } = Astro.locals.starlightRoute;
const lang = locale || 'es';
const pathname = Astro.url.pathname;

const isCli = pathname.includes('/cli/') || pathname.endsWith('/cli') || pathname.endsWith('/cli/');
const isApi =
  pathname.includes('/api/') ||
  pathname.includes('/functions/') ||
  pathname.endsWith('/api') ||
  pathname.endsWith('/api/') ||
  pathname.endsWith('/functions') ||
  pathname.endsWith('/functions/');
const isDocs =
  !isCli &&
  !isApi &&
  (pathname.includes('/docs/') || pathname.endsWith('/docs') || pathname.endsWith('/docs/'));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsHref = `${base}/${lang}/docs/`;
const cliHref = `${base}/${lang}/cli/`;
const apiHref = `${base}/${lang}/api/`;

// Language toggle target
const altLang = lang === 'es' ? 'en' : 'es';
const altLangLabel = lang === 'es' ? 'English' : 'Español';
let altLangHref = `${base}/${altLang}/`;
if (pathname.includes('/es/')) {
  altLangHref = pathname.replace('/es/', '/en/');
} else if (pathname.includes('/en/')) {
  altLangHref = pathname.replace('/en/', '/es/');
}
---

<div class="header">
  <div class="header-left sl-flex">
    <!-- Brand Title (no gap between testform and dot) -->
    <a href={`${base}/${lang}/`} class="site-title-custom" aria-label="testform home">
      <span class="brand-name">testform<span class="brand-dot">.</span></span>
      <span class="tac-pill">TaC</span>
    </a>

    <!-- Clean text links (NOT buttons) -->
    <nav class="nav-links sl-hidden md:sl-flex" aria-label="Main Navigation">
      <a href={docsHref} class:list={['nav-link', { active: isDocs }]}>Docs</a>
      <a href={cliHref} class:list={['nav-link', { active: isCli }]}>CLI</a>
      <a href={apiHref} class:list={['nav-link', { active: isApi }]}>API</a>
    </nav>
  </div>

  <div class="header-center sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>

  <!-- Pure Icons on the Right: GitHub, Theme Mode, Language -->
  <div class="header-right sl-flex items-center gap-1.5 print:hidden">
    <!-- GitHub Icon Link -->
    <a
      href="https://github.com/fromeroc9/testform"
      target="_blank"
      rel="noopener noreferrer"
      class="header-icon-btn"
      aria-label="GitHub Repository"
      title="GitHub"
    >
      <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
    </a>

    <!-- Theme Toggle Icon Button -->
    <button
      id="starlight-theme-toggle"
      type="button"
      class="header-icon-btn"
      aria-label={lang === 'es' ? 'Cambiar modo claro/oscuro' : 'Toggle dark/light mode'}
      title={lang === 'es' ? 'Cambiar modo' : 'Toggle theme'}
      onclick="toggleSiteTheme()"
    >
      <span class="theme-icon-sun">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </span>
      <span class="theme-icon-moon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </span>
    </button>

    <!-- Language Toggle Icon Button (Icon only) -->
    <a
      href={altLangHref}
      class="header-icon-btn"
      aria-label={lang === 'es' ? `Cambiar idioma a ${altLangLabel}` : `Switch language to ${altLangLabel}`}
      title={lang === 'es' ? `Cambiar idioma a ${altLangLabel}` : `Switch language to ${altLangLabel}`}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
    </a>

    <!-- VS Code Extension Link -->
    <a
      href="https://github.com/fromeroc9/testform-vscode/blob/master/testform-1.0.0.vsix"
      target="_blank"
      rel="noopener noreferrer"
      class="header-vscode-btn"
      aria-label={lang === 'es' ? 'Descargar extensión para VS Code (.vsix)' : 'Download VS Code extension (.vsix)'}
      title={lang === 'es' ? 'Descargar extensión Testform para VS Code (.vsix)' : 'Download Testform VS Code Extension (.vsix)'}
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/>
      </svg>
      <span class="vscode-btn-text">VS Code</span>
    </a>
  </div>
</div>

<script is:inline>
  function toggleSiteTheme() {
    const isDark = document.documentElement.dataset.theme === 'dark' || document.documentElement.classList.contains('dark');
    const next = isDark ? 'light' : 'dark';

    if (next === 'dark') {
      document.documentElement.classList.add('dark');
      document.documentElement.dataset.theme = 'dark';
    } else {
      document.documentElement.classList.remove('dark');
      document.documentElement.dataset.theme = 'light';
    }

    localStorage.setItem('starlight-theme', next);
    localStorage.setItem('theme', next);
  }
</script>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: 1.5rem;
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      min-width: 0;
    }

    /* Brand Name without gap */
    .site-title-custom {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      text-decoration: none !important;
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--sl-color-white);
    }

    .brand-name {
      display: inline-flex;
      align-items: baseline;
      color: var(--sl-color-white);
    }

    .brand-dot {
      color: var(--sl-color-accent, #2563eb);
      font-weight: 800;
    }

    .tac-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 0.1rem 0.35rem;
      border-radius: 0.25rem;
      background: rgba(37, 99, 235, 0.1);
      color: var(--sl-color-accent, #2563eb);
      border: 1px solid rgba(37, 99, 235, 0.25);
      text-transform: uppercase;
      line-height: 1.2;
    }

    :root[data-theme='dark'] .tac-pill {
      background: rgba(59, 130, 246, 0.15);
      color: #60a5fa;
      border-color: rgba(59, 130, 246, 0.3);
    }

    /* Navigation Links: Plain Text, NOT buttons */
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .nav-link {
      display: inline-block;
      padding: 0.25rem 0;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--sl-color-gray-2);
      text-decoration: none !important;
      background: transparent !important;
      border: none !important;
      transition: color 0.15s ease;
    }

    .nav-link:hover {
      color: var(--sl-color-white);
    }

    .nav-link.active {
      color: var(--sl-color-accent, #2563eb) !important;
      font-weight: 600;
    }

    /* Header Icons Only */
    .header-right {
      display: flex;
      gap: 0.4rem;
      align-items: center;
    }

    .header-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.1rem;
      height: 2.1rem;
      border-radius: 0.375rem;
      color: var(--sl-color-gray-2);
      background: transparent;
      border: 1px solid transparent;
      text-decoration: none !important;
      cursor: pointer;
      transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      position: relative;
    }

    .header-icon-btn:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
      border-color: var(--sl-color-hairline);
    }

    /* Theme icon toggle display */
    .theme-icon-sun,
    .theme-icon-moon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
    }

    .theme-icon-sun {
      display: none;
    }
    .theme-icon-moon {
      display: inline-flex;
    }

    :root[data-theme='dark'] .theme-icon-sun {
      display: inline-flex;
      color: #fbbf24;
    }
    :root[data-theme='dark'] .theme-icon-moon {
      display: none;
    }

    /* VS Code Extension Button */
    .header-vscode-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0 0.55rem;
      height: 2.1rem;
      border-radius: 0.375rem;
      color: #2563eb;
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.25);
      text-decoration: none !important;
      font-size: 0.78rem;
      font-weight: 600;
      font-family: var(--sl-font-mono, monospace);
      transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }

    .header-vscode-btn:hover {
      color: #3b82f6;
      background: rgba(37, 99, 235, 0.18);
      border-color: rgba(37, 99, 235, 0.45);
    }

    :root[data-theme='dark'] .header-vscode-btn {
      color: #60a5fa;
      background: rgba(59, 130, 246, 0.12);
      border-color: rgba(59, 130, 246, 0.3);
    }

    :root[data-theme='dark'] .header-vscode-btn:hover {
      color: #93c5fd;
      background: rgba(59, 130, 246, 0.22);
      border-color: rgba(59, 130, 246, 0.5);
    }

    @media (max-width: 640px) {
      .header-vscode-btn .vscode-btn-text {
        display: none;
      }
      .header-vscode-btn {
        padding: 0;
        width: 2.1rem;
        justify-content: center;
      }
    }

    @media (min-width: 50rem) {
      .header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-content: center;
      }
    }
  }
</style>
